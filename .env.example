# --- LLM: any OpenAI-compatible /v1/chat/completions endpoint with streaming + tool calls ---
DOCCHECK_LLM_BASE_URL=https://router.cheap/v1
DOCCHECK_LLM_API_KEY=
DOCCHECK_SCOUT_MODEL=gpt-6-luna
DOCCHECK_ANALYST_MODEL=deepseek-v4.1-flash
DOCCHECK_CRITIC_MODEL=gpt-6.1-sol
DOCCHECK_FALLBACK_MODEL=deepseek-v4.1-flash
DOCCHECK_MAX_OUTPUT_TOKENS=12000

# --- Optional: run the Analyst on a local model (LM Studio / Ollama / vLLM, OpenAI-compatible) ---
# DOCCHECK_ANALYST_BASE_URL=http://127.0.0.1:1234/v1
# DOCCHECK_ANALYST_MODEL=mistralai/devstral-small-2-2512

# --- Retrieval ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
DOCCHECK_COLLECTION=doccheck
# DOCCHECK_EMBED_MODEL=intfloat/multilingual-e5-large    (see evals/retrieval.md)
# DOCCHECK_CORPUS_DIR=data/corpus                         (folder with .md/.txt/.html/.docx/.pdf)

# Set to 1 to re-record tests/fixtures/llm/*.json from the live API
DOCCHECK_RECORD=0
